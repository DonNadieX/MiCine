name: Compilar APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Descomprimir proyecto
        run: |
          ZIP=$(ls *.zip | head -n 1)
          echo "Usando $ZIP"
          unzip -q -o "$ZIP" -d proyecto
          DIR=$(dirname $(find proyecto -name settings.gradle.kts | head -n 1))
          echo "PROYECTO=$DIR" >> $GITHUB_ENV

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.10.2"

      - name: Compilar
        working-directory: ${{ env.PROYECTO }}
        run: gradle assembleDebug --no-daemon

      - uses: actions/upload-artifact@v4
        with:
          name: MiCine-apk
          path: ${{ env.PROYECTO }}/app/build/outputs/apk/debug/*.apk
